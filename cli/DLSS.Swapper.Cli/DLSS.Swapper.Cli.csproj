<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A windows subsystem executable, not a console one, and this is the whole
      reason: Windows allocates a console for a console subsystem process when
      whatever started it has none of its own. The Steam plugin's Lua host has
      none, so every call flashed a terminal on screen. A windows subsystem
      process is allocated nothing, and still writes to a pipe when its caller
      makes one - which is how the plugin reads it.

      Run by hand it would then print into the void, so Main attaches to the
      calling terminal's console when its output is not already redirected. See
      the note there.
    -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>swapshelf-cli</AssemblyName>

    <!--
      The app's version, because this is installed beside the app and a person
      reading its file properties is asking which release they have. Without it
      the sdk defaults to 1.0.0.0, which is what the first build of 2.2.2.0 that
      packaged this carried: a 1.0.0.0 executable sitting next to a 2.2.2.0
      one. VersionConsistencyTests checks this against the app now, the way it
      checks the other four places the version is written by hand.
    -->
    <Version>3.0.6.1</Version>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DLSS_Swapper.Cli</RootNamespace>
    <Platforms>x64</Platforms>

    <!--
      The same four the app declares. Release_Portable is the one that matters:
      it is what defines PORTABLE in the app project this references, which is
      what decides where the database is looked for. Without it declared here
      the portable packaging build has no configuration of that name to ask for.
    -->
    <Configurations>Debug;Release;Debug_Portable;Release_Portable</Configurations>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!--
      The same WinUI properties the app and the test project carry. This exe never creates a
      window, but the assembly it references is a WinUI one and its types have to be able to
      activate - the resource manager most of all, which every translated string goes through.
    -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Same duplication as the test project; see the note in its csproj. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>

    <!--
      NETSDK1152. Publishing this stages the Windows App SDK's self contained
      native files twice - once from this project and once from the app project
      it references, both of them WindowsAppSDKSelfContained - and the sdk
      refuses to choose between two files claiming the same relative path.
      The two sets come from the same package version and were compared before
      this was added: 110 files, all byte identical, none differing. So there is
      nothing to choose between, and either copy is the same publish.

      The app test project references the app the same way and never hits this,
      because it only ever builds - this check runs at publish.

      Scoped to this project deliberately, not set in Directory.Build.props: the
      app's own publish should still fail if it ever stages two genuinely
      different files under one name.
    -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!--
    Warnings are errors. The build carried fourteen for months, all from one cause, and a warning
    that is always there is one nobody reads. NuGet's audit codes stay warnings: an advisory
    published tomorrow, or a restore with no network, must not stop a compile. The "Check for
    vulnerable packages" step in CI is where that fails, and it says why.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DLSS Swapper.csproj" />
  </ItemGroup>

  <!--
    ResourceHelper builds its resource map from a resources.pri beside the running executable, in a
    static initializer, so without it the first translated string throws rather than coming back
    untranslated. Same rename the test project does, for the same reason.
  -->
  <Target Name="CopyAppPriFile" AfterTargets="AfterBuild">
    <Copy SourceFiles="$(TargetDir)Swapshelf.pri"
          DestinationFiles="$(TargetDir)resources.pri"
          Condition="Exists('$(TargetDir)Swapshelf.pri')" />
  </Target>

</Project>
