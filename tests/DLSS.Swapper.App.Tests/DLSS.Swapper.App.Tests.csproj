<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DLSS_Swapper.App.Tests</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!--
      CS0436: the Windows App SDK compiles its auto initializers into every project that uses
      WinUI, so this project builds its own AutoInitialize and NativeMethods while also referencing
      an app assembly that already contains them. The compiler resolves to the local copy, which is
      correct. The initializers are included unconditionally by the SDK's targets rather than gated
      by a property, and dropping them would take the undocked reg free WinRT bootstrap with them,
      which is what lets the test host activate WinRT types such as the resource manager. So the
      duplication is expected here and only the warning is worth removing.
    -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <!--
    Warnings are errors. The build carried fourteen for months, all from one cause, and a warning
    that is always there is one nobody reads. NuGet's audit codes stay warnings: an advisory
    published tomorrow, or a restore with no network, must not stop a compile. The "Check for
    vulnerable packages" step in CI is where that fails, and it says why.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DLSS Swapper.csproj" />
  </ItemGroup>

  <!--
    ResourceHelper resolves strings from a resources.pri next to the running executable, and builds
    its resource map in a static initializer, so without the file any code path that reads a
    translated string throws on first touch rather than returning an untranslated one. The app
    renames its own pri to that name after build (see src/CopyPriFile.targets); the test output
    already has the app's pri copied in by the project reference, so it needs the same rename.
  -->
  <Target Name="CopyAppPriFile" AfterTargets="AfterBuild">
    <Copy SourceFiles="$(TargetDir)Swapshelf.pri"
          DestinationFiles="$(TargetDir)resources.pri"
          Condition="Exists('$(TargetDir)Swapshelf.pri')" />
  </Target>

</Project>
