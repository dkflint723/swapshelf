<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DLSS_Swapper.DiagnosticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DLSS_Swapper"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.TranslationProperties.ApplicationTilteDiagnosticsWindowText, Mode=OneWay}">

    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Redacted by default: the text below is meant to be pasted into a bug report, and the
            paths in it say where the user keeps their games and what their account is called. The
            checkbox that puts them back says so in as many words.
        -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
            <Button Content="{x:Bind ViewModel.TranslationProperties.ClickToCopyDetailsText, Mode=OneWay}" Command="{x:Bind ViewModel.CopyTextCommand}" />
            <CheckBox Content="{x:Bind ViewModel.TranslationProperties.IncludeRealPathsText, Mode=OneWay}" IsChecked="{x:Bind ViewModel.IncludeRealPaths, Mode=TwoWay}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.TranslationProperties.RedactedNoteText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
        <TextBox Grid.Row="2" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Text="{x:Bind ViewModel.DiagnosticsLog, Mode=OneWay}" />
    </Grid>

</Window>
