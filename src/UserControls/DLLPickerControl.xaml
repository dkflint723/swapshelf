<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DLSS_Swapper.UserControls.DLLPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    xmlns:data="using:DLSS_Swapper.Data"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    d:DataContext="{d:DesignInstance Type=usercontrols:DLLPickerControlModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d"
    MinWidth="400">

    <UserControl.Resources>
        <converters:DLSSStateVisibilityConverter x:Key="IsDownloadingConverter" DesierdState="Downloading" />
        <converters:DLSSStateVisibilityConverter x:Key="IsDownloadedConverter" DesierdState="Downloaded" />
        <converters:DLSSStateVisibilityConverter x:Key="IsNotFoundConverter" DesierdState="NotFound" />
        <converters:DLSSStateVisibilityConverter x:Key="IsImportedConverter" DesierdState="Imported" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:StringVisibilityConverter x:Key="StringVisibilityConverter" EmptyValue="Collapsed" NotEmptyValue="Visible" />

        <!-- Grouped by release line, like the upscalers page: one wall of numbers, same cure. -->
        <CollectionViewSource
            x:Name="GroupedPickerVersions"
            IsSourceGrouped="True"
            ItemsPath="Versions"
            Source="{x:Bind ViewModel.VersionGroups, Mode=OneWay}" />
    </UserControl.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- Reserved for: https://github.com/beeradmoore/dlss-swapper/issues/227 -->
        <!-- <InfoBar
              IsOpen="True"
              Severity="Informational"
              IsClosable="False"
              Title="Game asset not found in Swapshelf"
              Message="Would you like to import the current game asset into Swapshelf?">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind ViewModel.TranslationProperties.ImportText, Mode=OneWay}" />
                </InfoBar.ActionButton>
        </InfoBar>-->

        <Grid Grid.Row="0" ColumnSpacing="6" RowSpacing="4" Visibility="{x:Bind ViewModel.BackupGameAsset, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.TranslationProperties.OriginalDllText, Mode=OneWay}" FontWeight="Bold"/>
            <TextBox Grid.Row="1" Grid.Column="0" IsReadOnly="True" Text="{x:Bind ViewModel.BackupGameAsset.DisplayName, Mode=OneWay}" VerticalAlignment="Stretch"/>
            <!--
                Words as well as a glyph. This button writes into the game folder, and it was
                icon-only - worse, its glyph was E72C, which four other surfaces use for read-only
                rescans, so one shape meant both "look again" and "replace the file". ED62 is
                already the reset glyph on the game page; restore and reset share it now, and E72C
                keeps its single meaning. The automation name stays explicit: a StackPanel content
                does not reliably derive one from its TextBlock.
            -->
            <Button Grid.Row="1" Grid.Column="1" AutomationProperties.Name="{x:Bind ViewModel.TranslationProperties.OriginalDllRestoreText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.TranslationProperties.OriginalDllRestoreText, Mode=OneWay}" VerticalAlignment="Stretch" Command="{x:Bind ViewModel.ResetDllCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" FontSize="14" Glyph="&#xED62;"/>
                        <TextBlock Text="{x:Bind ViewModel.TranslationProperties.OriginalDllRestoreText, Mode=OneWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="6" RowSpacing="4" Visibility="{x:Bind ViewModel.CurrentGameAsset, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.TranslationProperties.CurrentDllText, Mode=OneWay}" FontWeight="Bold"/>
            <TextBox Grid.Row="1" Grid.Column="0" IsReadOnly="True" Text="{x:Bind ViewModel.CurrentGameAsset.DisplayName, Mode=OneWay}" VerticalAlignment="Stretch"/>
            <Button Grid.Row="1" Grid.Column="1" AutomationProperties.Name="{x:Bind ViewModel.TranslationProperties.OpenDllLocationText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.TranslationProperties.OpenDllLocationText, Mode=OneWay}" VerticalAlignment="Stretch" Command="{x:Bind ViewModel.OpenDllPathCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" FontSize="14" Glyph="&#xE8A7;"/>
                        <TextBlock Text="{x:Bind ViewModel.TranslationProperties.OpenDllLocationText, Mode=OneWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <!-- On HasAnyRecords, not the filtered count: a query that matches nothing must leave
             the box on screen to be cleared. -->
        <TextBox
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.HasAnyRecords, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="{x:Bind ViewModel.TranslationProperties.SearchVersionsText, Mode=OneWay}" />

        <ListView Grid.Row="3" Visibility="{x:Bind ViewModel.AnyDLLsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" ItemsSource="{x:Bind GroupedPickerVersions.View, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedDLLRecord, Mode=TwoWay}" MaxHeight="400">
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="data:DllVersionGroup">
                            <usercontrols:SectionRule Margin="0,8,0,2" Label="{x:Bind Label}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:DLLRecord">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind DisplayName}" />

                            <!-- The curated why, on the row it is about. Null for most rows. -->
                            <TextBlock
                                Text="{x:Bind RecommendationNote}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind RecommendationNote, Converter={StaticResource StringVisibilityConverter}}"
                                Foreground="{ThemeResource DsTextSecondaryBrush}" />
                        </StackPanel>

                        <ProgressRing Grid.Column="1" Visibility="{x:Bind LocalRecord, Converter={StaticResource IsDownloadingConverter}, Mode=OneWay}" AutomationProperties.Name="{x:Bind TranslationProperties.DownloadingText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind TranslationProperties.DownloadingText, Mode=OneWay}" Minimum="0" Maximum="100" IsIndeterminate="{x:Bind LocalRecord.FileDownloader.IsIndeterminate, Mode=OneWay}" Value="{x:Bind LocalRecord.FileDownloader.Percent, Mode=OneWay}" HorizontalAlignment="Right" Width="20" Height="20"  />

                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Grid.Column="1" Visibility="{x:Bind LocalRecord, Converter={StaticResource IsNotFoundConverter}, Mode=OneWay}" AutomationProperties.Name="{x:Bind TranslationProperties.RequiresDownloadText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind TranslationProperties.RequiresDownloadText, Mode=OneWay}" HorizontalAlignment="Right" Glyph="&#xE896;" Width="20" Height="20" />

                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Grid.Column="1" Visibility="{x:Bind LocalRecord, Converter={StaticResource IsImportedConverter}, Mode=OneWay}" AutomationProperties.Name="{x:Bind TranslationProperties.ImportedText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind TranslationProperties.ImportedText, Mode=OneWay}" HorizontalAlignment="Right" Glyph="&#xE7B8;" Width="20" Height="20" />

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Shares the list's row: exactly one of the two is ever visible. -->
        <InfoBar Grid.Row="3"
              Visibility="{x:Bind ViewModel.AnyDLLsVisible, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
              Severity="Warning"
              IsOpen="True"
              IsClosable="False"
              Title="{x:Bind ViewModel.TranslationProperties.NoDllsFoundText, Mode=OneWay}"
              Message="{x:Bind ViewModel.TranslationProperties.PleaseNavigateLibraryToDownloadDllsText, Mode=OneWay}">
        </InfoBar>

        <!--
            How much is known about the selected version in this game. A shape, a label and one
            sentence of reason; no colour carries meaning alone. Hidden until something is selected.
        -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.SelectedConfidence, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
            <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="{x:Bind ViewModel.SelectedConfidence.Glyph, Mode=OneWay}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.SelectedConfidence.Label, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.SelectedConfidence.Reason, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource DsTextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>
