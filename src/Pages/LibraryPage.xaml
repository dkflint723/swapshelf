<Page
    x:Class="DLSS_Swapper.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:system="using:System"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:data="using:DLSS_Swapper.Data"
    xmlns:pages="using:DLSS_Swapper.Pages"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    x:Name="thisPage">

    <Page.Resources>
        <converters:DLSSStateVisibilityConverter x:Key="IsDownloadingConverter" DesierdState="Downloading" />
        <converters:DLSSStateVisibilityConverter x:Key="IsDownloadedConverter" DesierdState="Downloaded" />
        <converters:DLSSStateVisibilityConverter x:Key="IsNotFoundConverter" DesierdState="NotFound" />
        <converters:DLSSStateVisibilityConverter x:Key="IsLocalConverter" DesierdState="Imported" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:StringVisibilityConverter x:Key="StringVisibilityConverter" EmptyValue="Collapsed" NotEmptyValue="Visible" />
        <converters:BytesToMegaBytesConverter x:Key="BytesToMegaBytesConverter" />
        <converters:TotalBytesVisbilityConverter x:Key="TotalBytesVisbilityConverter" />

        <!--
            Grouped by release line. One engine can carry over a hundred versions, and as a flat run
            they are a wall of near identical numbers.
        -->
        <CollectionViewSource
            x:Name="GroupedVersions"
            IsSourceGrouped="True"
            ItemsPath="Versions"
            Source="{x:Bind ViewModel.VersionGroups, Mode=OneWay}" />
    </Page.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,0,16,0">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.TranslationProperties.PageTitle, Mode=OneWay}" Margin="16,0,0,0" TextWrapping="NoWrap" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <muxc:ProgressRing IsActive="True" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"  />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.ImportText, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE8B5;"  />
                    </AppBarButton.Content>
                    <AppBarButton.Flyout>
                        <!-- Kept inside the window, and below its button; see GameGridPage's View Type menu. -->
                        <MenuFlyout ShouldConstrainToRootBounds="True" Placement="Bottom">
                            <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.ImportFromLocalFilesText, Mode=OneWay}" Command="{x:Bind ViewModel.ImportCommand}" />
                            <MenuFlyoutSubItem Text="NVIDIA">
                                <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.ImportFromDriverText, Mode=OneWay}" Command="{x:Bind ViewModel.ImportFromNVIDIADriverCommand}" />
                                <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.ImportFromDownloadServerText, Mode=OneWay}" Command="{x:Bind ViewModel.ImportFromNVIDIAServerCommand}" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>

                <AppBarButton HorizontalAlignment="Right" Label="{x:Bind ViewModel.TranslationProperties.ExportAllText, Mode=OneWay}" Command="{x:Bind ViewModel.ExportAllCommand}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xEDE1;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton HorizontalAlignment="Right" Label="{x:Bind ViewModel.TranslationProperties.DownloadLatestText, Mode=OneWay}" Command="{x:Bind ViewModel.DownloadLatestCommand}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE896;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton HorizontalAlignment="Right" Label="{x:Bind ViewModel.TranslationProperties.RefreshText, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshCommand}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Content>
                </AppBarButton>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="AdminInfoBar"
                 Grid.Row="1"
                 IsOpen="True"
                 Severity="Warning"
                 IsClosable="False"
                 Title="{x:Bind ViewModel.TranslationProperties.WarningText, Mode=OneWay}"
                 Message="{x:Bind ViewModel.TranslationProperties.ApplicationRunsInAdministrativeModeInfo, Mode=OneWay}"
                 Visibility="{x:Bind system:Environment.IsPrivilegedProcess, Converter={StaticResource BoolToVisibilityConverter}}" />


        <!--
            Above both columns because it narrows both. The counts beside each engine move with it,
            so a count and the list it opens still come from one rule, and a search across nine
            engines stays usable: the column says which ones have matches instead of making you
            click all nine to find out.
        -->
        <Grid Grid.Row="2" Height="40" Margin="30,8,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                x:Name="SearchBox"
                Height="32"
                VerticalAlignment="Center"
                PlaceholderText="{x:Bind ViewModel.TranslationProperties.SearchText, Mode=OneWay}"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{x:Bind ViewModel.TranslationProperties.SearchHintText, Mode=OneWay}" />

            <!-- The sentence that stops the narrowed counts reading as versions gone missing. -->
            <TextBlock
                Grid.Column="1"
                Text="{x:Bind ViewModel.SearchSummary, Mode=OneWay}"
                FontSize="12"
                VerticalAlignment="Center"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind ViewModel.SearchActiveVisibility, Mode=OneWay}"
                Foreground="{ThemeResource DsTextSecondaryBrush}" />

            <!-- Words, and it says what you get back rather than what it takes away. -->
            <Button
                Grid.Column="2"
                Height="32"
                Padding="14,0"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource DsCornerRadius}"
                Content="{x:Bind ViewModel.TranslationProperties.ClearSearchText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.SearchActiveVisibility, Mode=OneWay}"
                Command="{x:Bind ViewModel.ClearSearchCommand}" />
        </Grid>

        <!--
            The engines down the left, with how many versions of each are known. The bar this
            replaces scrolled horizontally, so the engines past the right edge were reachable only
            by dragging a strip that did not look draggable, and it carried no counts at all.
        -->
        <Grid Grid.Row="3" Margin="16,8,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ItemsControl
                Grid.Column="0"
                ItemsSource="{x:Bind ViewModel.UpscalerTypes, Mode=OneWay}"
                BorderThickness="0,0,1,0"
                BorderBrush="{ThemeResource DsLineBrush}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:UpscalerTypeItem">
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Height="34"
                            Padding="14,0"
                            CornerRadius="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Command="{Binding ElementName=thisPage, Path=ViewModel.SelectUpscalerTypeCommand}"
                            CommandParameter="{x:Bind}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Flush to the column edge, matching the sidebar's active marker. -->
                                <Border
                                    Grid.ColumnSpan="2"
                                    Width="2"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    Margin="-14,0,0,0"
                                    Background="{StaticResource DsAccentBrush}"
                                    Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    FontSize="13"
                                    VerticalAlignment="Center"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"
                                    FontWeight="{x:Bind LabelWeight, Mode=OneWay}"
                                    Foreground="{ThemeResource DsTextPrimaryBrush}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind CountText, Mode=OneWay}"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource DsTextTertiaryBrush}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ListView
                Grid.Column="1"
                x:Name="MainGridView"
                Margin="16,0,0,0"
                ItemsSource="{x:Bind GroupedVersions.View, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="MainGridView_ItemClick">

                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="data:DllVersionGroup">
                                <usercontrols:SectionRule Margin="0,14,0,2" Label="{x:Bind Label}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:DLLRecord">
                    <Grid Height="42"
                          ColumnSpacing="12"
                          BorderThickness="0,0,0,1"
                          BorderBrush="{ThemeResource DsLineBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource DsTextPrimaryBrush}" />

                        <!--
                            Where the file is, in words. It used to be readable only from which
                            buttons the row had, which is state carried by iconography alone.
                        -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon
                                FontSize="11"
                                VerticalAlignment="Center"
                                Glyph="{x:Bind data:DllRecordState.Glyph(LocalRecord.IsDownloaded, LocalRecord.IsImported, LocalRecord.IsDownloading), Mode=OneWay}"
                                Foreground="{ThemeResource DsTextSecondaryBrush}" />
                            <TextBlock
                                Text="{x:Bind data:DllRecordState.Describe(LocalRecord.IsDownloaded, LocalRecord.IsImported, LocalRecord.IsDownloading), Mode=OneWay}"
                                FontSize="12"
                                VerticalAlignment="Center"
                                TextWrapping="NoWrap"
                                Foreground="{ThemeResource DsTextSecondaryBrush}" />
                        </StackPanel>

                        <!--
                            How many games have this exact file in place. New, and the point of the
                            page: everything else here describes the file, this says what would
                            break if it went.
                        -->
                        <!--
                            What the file costs, beside what it is worth. The two together are the
                            whole question in front of the delete button, and the page could answer
                            neither.
                        -->
                        <TextBlock
                            Grid.Column="3"
                            Text="{x:Bind FileSize, Converter={StaticResource BytesToMegaBytesConverter}}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            TextWrapping="NoWrap"
                            Foreground="{ThemeResource DsTextTertiaryBrush}" />

                        <!-- The curated why, on the row it is about. Empty for most rows. -->
                        <TextBlock
                            Grid.Column="4"
                            Text="{x:Bind RecommendationNote}"
                            FontSize="12"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind RecommendationNote}"
                            Visibility="{x:Bind RecommendationNote, Converter={StaticResource StringVisibilityConverter}}"
                            Foreground="{ThemeResource DsTextSecondaryBrush}" />

                        <!--
                            The count is the answer to "is this safe to delete", so it is also the
                            place to ask which games those are. It is a button only when there are
                            games behind it: "Not used" that looks clickable and does nothing is
                            worse than plain text.
                        -->
                        <Button
                            Grid.Column="2"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource TextBlockButtonStyle}"
                            Visibility="{x:Bind data:DllUsage.UsedVisibility(GamesUsingCount), Mode=OneWay}"
                            Command="{Binding ElementName=thisPage, Path=ViewModel.ShowGamesUsingCommand}"
                            CommandParameter="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind TranslationProperties.ShowGamesUsingText, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind data:DllUsage.DescribeCount(GamesUsingCount), Mode=OneWay}"
                                FontSize="12"
                                TextWrapping="NoWrap"
                                TextDecorations="Underline"
                                Foreground="{ThemeResource DsTextSecondaryBrush}" />
                        </Button>

                        <!--
                            Tertiary, like the file size: "Not used" is the default state of most
                            of two hundred rows, and at secondary weight the page was a wall of it.
                            The rows with games behind them keep the brighter ink - and the words,
                            so nothing rests on the brightness alone.
                        -->
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind data:DllUsage.DescribeCount(GamesUsingCount), Mode=OneWay}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            TextWrapping="NoWrap"
                            Visibility="{x:Bind data:DllUsage.NotUsedVisibility(GamesUsingCount), Mode=OneWay}"
                            Foreground="{ThemeResource DsTextTertiaryBrush}" />

                        <!--
                            Along the row's own bottom edge rather than inside a column, so it reads
                            as this row filling up. It sits on the hairline the row already draws, so
                            nothing moves when it appears and nothing is left behind when it goes.
                        -->
                        <ProgressBar
                            Grid.Column="0"
                            Grid.ColumnSpan="6"
                            Height="2"
                            Minimum="0"
                            Maximum="100"
                            Margin="0,0,0,-1"
                            VerticalAlignment="Bottom"
                            IsIndeterminate="{x:Bind LocalRecord.FileDownloader.IsIndeterminate, Mode=OneWay}"
                            Value="{x:Bind LocalRecord.FileDownloader.Percent, Mode=OneWay}"
                            Visibility="{x:Bind LocalRecord, Converter={StaticResource IsDownloadingConverter}, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind TranslationProperties.DownloadingText, Mode=OneWay}" />

                        <!--
                            One menu instead of a row of bare icon buttons. The buttons meant the
                            row's actions changed shape with its state, and there was nowhere to put
                            the things that apply to every row: what the file is, and its hash.
                        -->
                        <Button
                            Grid.Column="5"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="{StaticResource DsCornerRadius}"
                            ToolTipService.ToolTip="{x:Bind TranslationProperties.MoreActionsText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind TranslationProperties.MoreActionsText, Mode=OneWay}">
                            <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource DsTextSecondaryBrush}" />
                            <Button.Flyout>
                                <!--
                                    Kept inside the window. This one is at the right edge of the
                                    row, so unconstrained it opened past the window and the ends of
                                    its longest items were cut off by the screen rather than by
                                    anything the app drew.
                                -->
                                <MenuFlyout ShouldConstrainToRootBounds="True">
                                    <MenuFlyoutItem
                                        Text="{x:Bind TranslationProperties.DownloadText, Mode=OneWay}"
                                        Visibility="{x:Bind LocalRecord, Converter={StaticResource IsNotFoundConverter}, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.DownloadRecordCommand}"
                                        CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE896;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutItem
                                        Text="{x:Bind TranslationProperties.CancelText, Mode=OneWay}"
                                        Visibility="{x:Bind LocalRecord, Converter={StaticResource IsDownloadingConverter}, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.CancelDownloadRecordCommand}"
                                        CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE711;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutItem
                                        Text="{x:Bind TranslationProperties.ExportText, Mode=OneWay}"
                                        Visibility="{x:Bind LocalRecord, Converter={StaticResource IsDownloadedConverter}, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.ExportRecordCommand}"
                                        CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xEDE1;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutItem
                                        Text="{x:Bind TranslationProperties.DownloadErrorText, Mode=OneWay}"
                                        Visibility="{x:Bind LocalRecord.HasDownloadError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.ShowDownloadErrorCommand}"
                                        CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE783;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator />

                                    <!--
                                        Only when there are games to show. The same click is on the
                                        count itself, which is where it is discoverable; this is
                                        where it is findable.
                                    -->
                                    <MenuFlyoutItem
                                        Text="{x:Bind TranslationProperties.ShowGamesUsingText, Mode=OneWay}"
                                        Visibility="{x:Bind data:DllUsage.UsedVisibility(GamesUsingCount), Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.ShowGamesUsingCommand}"
                                        CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7FC;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutItem
                                        Text="{x:Bind TranslationProperties.FileDetailsText, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.ShowRecordInfoCommand}"
                                        CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutItem
                                        Text="{x:Bind TranslationProperties.CopyHashText, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.CopyHashCommand}"
                                        CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <!-- Last, and after a separator: it is the only one that removes anything. -->
                                    <MenuFlyoutSeparator Visibility="{x:Bind LocalRecord, Converter={StaticResource IsDownloadedConverter}, Mode=OneWay}" />

                                    <MenuFlyoutItem
                                        Text="{x:Bind TranslationProperties.DeleteText, Mode=OneWay}"
                                        Visibility="{x:Bind LocalRecord, Converter={StaticResource IsDownloadedConverter}, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.DeleteRecordCommand}"
                                        CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>


                    </Grid>
                </DataTemplate>

                </ListView.ItemTemplate>
            </ListView>

            <!--
                Over the list only, never the engine column — the opposite of the games page, and
                deliberately: when a search matches nothing here, the counts beside the other
                engines are the answer, so covering them would hide it.
            -->
            <Grid
                Grid.Column="1"
                Margin="16,0,0,0"
                Padding="16,0"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}"
                Background="{ThemeResource DsBgBrush}">
                <StackPanel MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="12">
                    <TextBlock
                        Text="{x:Bind ViewModel.EmptyState.Title, Mode=OneWay}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource DsTextPrimaryBrush}" />

                    <TextBlock
                        Text="{x:Bind ViewModel.EmptyState.Body, Mode=OneWay}"
                        FontSize="13"
                        LineHeight="20"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource DsTextSecondaryBrush}" />

                    <Button
                        Height="34"
                        Padding="18,0"
                        Margin="0,4,0,0"
                        CornerRadius="{StaticResource DsCornerRadius}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Content="{x:Bind ViewModel.EmptyState.PrimaryLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.EmptyStatePrimaryCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
