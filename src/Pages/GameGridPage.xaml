<Page
    x:Class="DLSS_Swapper.Pages.GameGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:data="using:DLSS_Swapper.Data"
    xmlns:system="using:System"
    xmlns:pages="using:DLSS_Swapper.Pages"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    mc:Ignorable="d"
    d:DataContext="pages:GameGridPageModel"
    Loaded="Page_Loaded"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Required"
    KeyboardAcceleratorPlacementMode="Hidden"
    x:Name="RootGameGridPage">
    <!--
        Placement hidden because this accelerator belongs to the page rather than to any one
        control, and WinUI advertises it by floating an "Esc" tip under whatever happens to have
        focus. Arriving from the upscalers page that was the dismiss button on the filter chip,
        labelling it with a key that does something else.
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:StringVisibilityConverter x:Key="StringVisibilityConverter" EmptyValue="Collapsed" NotEmptyValue="Visible" />
        <ct_converters:StringVisibilityConverter x:Key="InverseStringVisibilityConverter" EmptyValue="Visible" NotEmptyValue="Collapsed" />
        <converters:BitmapImageUriConverter x:Key="BitmapImageUriConverter" />
        <!--
            Hidden games are dimmed rather than absent. 0.25 was set when they only ever appeared
            alongside normal rows, where it read as "ignore this one". On the hidden tab they are
            the entire list, so it has to stay legible; 0.55 is the same ratio the tokens use for
            secondary text.
        -->
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" TrueValue="0.55" FalseValue="1.0" NullValue="1.0" />

        <!--
            One header for both views. It was two identical copies, and a launcher group is the same
            thing whichever way the games under it are drawn.
        -->
        <!--
            The container has no size of its own, so a header that decides not to draw leaves no
            gap and no rule behind. Its own padding and the rule under it come from the template
            below, which is only there when the header is.
        -->
        <Style x:Key="ListGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <!--
                Not a tab stop. The container is a Control and stops by default, so Tab landed on
                the empty box around each launcher heading and then again on the heading's own
                button - two stops per group, one of which announces nothing and does nothing.
            -->
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!--
                Stripped to the content and nothing else. The stock template draws its own rule,
                which a hidden header kept drawing: a line across the page with no heading on it.
            -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewHeaderItem">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridGroupHeaderContainerStyle" TargetType="GridViewHeaderItem">
            <!-- For the reason on the list one above. -->
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewHeaderItem">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="data:GameGroup">
            <!-- Margin rather than padding, so the rule starts where the games below it do. -->
            <Grid
                Padding="0,10,0,8"
                Margin="15,0,0,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DsLineBrush}"
                Visibility="{x:Bind ShowsHeader, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <!--
                    A button around the whole header rather than a chevron you have to hit: the
                    heading is the target people aim at, and a launcher name is a much bigger one.

                    IsTabStop tracks IsCollapsible alongside IsHitTestVisible, which turns off the
                    mouse and nothing else: a group that cannot be folded still took a tab stop and
                    still folded nothing when Space was pressed on it, so the keyboard was offered
                    something the mouse was not.
                -->
                <Button
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Tag="{x:Bind}"
                    IsHitTestVisible="{x:Bind IsCollapsible}"
                    IsTabStop="{x:Bind IsCollapsible}"
                    AutomationProperties.Name="{x:Bind Name}"
                    Click="GroupHeader_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Name}" Margin="0" Style="{StaticResource TitleTextBlockStyle}" />
                        <FontIcon
                            FontSize="12"
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            Glyph="{x:Bind ChevronGlyph, Mode=OneWay}"
                            Visibility="{x:Bind IsCollapsible, Converter={StaticResource BoolToVisibilityConverter}}"
                            Foreground="{ThemeResource DsTextSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>


        <DataTemplate x:Key="ListViewTemplate" x:DataType="pages:GameGridPageModel">
            <ListView ItemsSource="{x:Bind CurrentCollectionView, Mode=OneWay}" ItemClick="GridAndListView_ItemClick" HorizontalAlignment="Stretch" SelectionMode="None" IsItemClickEnabled="True" Padding="20">

                <!--
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Padding" Value="12,0,0,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                -->

                <ListView.GroupStyle>
                    <!--
                        The header decides for itself whether it is drawn, rather than HidesIfEmpty
                        deciding for it. A folded section is empty by that test too, and its header
                        is the only way to unfold it.
                    -->
                    <GroupStyle
                        HidesIfEmpty="False"
                        HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                        HeaderContainerStyle="{StaticResource ListGroupHeaderContainerStyle}" />
                </ListView.GroupStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:Game">
                        <!--
                            74px row with a 1px bottom rule rather than a card. The redesign drops
                            the vendor coloured badges: the technology is a word in the engines
                            column, and the state is a glyph plus a sentence, so nothing depends on
                            telling green from red.
                        -->
                        <Grid ColumnSpacing="16"
                              Height="74"
                              Padding="26,0"
                              BorderThickness="0,0,0,1"
                              BorderBrush="{ThemeResource DsLineBrush}"
                              Background="Transparent"
                              Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <Grid.ContextFlyout>
                                <!-- Kept inside the window; see the View Type menu below for why. -->
                                <MenuFlyout ShouldConstrainToRootBounds="True">
                                    <!--
                                        Checked rather than two items, so the row states the setting
                                        rather than only offering to change it.
                                    -->
                                    <ToggleMenuFlyoutItem
                                        Text="{Binding ElementName=RootGameGridPage, Path=ViewModel.TranslationProperties.NeverUpdateThisGameText, Mode=OneWay}"
                                        IsChecked="{x:Bind SkipUpdates, Mode=OneWay}"
                                        Command="{Binding ElementName=RootGameGridPage, Path=ViewModel.ToggleSkipUpdatesCommand}"
                                        CommandParameter="{x:Bind}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                Portrait, matching the 400x600 art the cache actually holds. The
                                handoff drew a 96x54 landscape thumbnail, which assumes key art this
                                app does not have: cropping a poster to 16:9 leaves a band through
                                its middle, which is unrecognisable for most games.
                            -->
                            <Border Grid.Column="0"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource DsLine2Brush}"
                                    CornerRadius="{StaticResource DsCornerRadius}"
                                    Width="44"
                                    Height="66"
                                    VerticalAlignment="Center"
                                    FlowDirection="LeftToRight">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill">
                                        <ImageBrush.ImageSource>
                                            <!--
                                                Decoded at the size it is drawn at. The cell is a
                                                fixed 44x66 and the file behind it is 400x600, so
                                                every realized row was decoding roughly a megabyte
                                                of pixels to paint about three thousand of them -
                                                and doing it again on every scroll, because
                                                A cache miss makes a realization a fresh
                                                read and decode.

                                                Logical rather than the default Physical, so the
                                                number is in the same units as the Width above it
                                                and a scaled display still gets enough pixels.
                                            -->
                                            <BitmapImage DecodePixelType="Logical" DecodePixelWidth="44" UriSource="{x:Bind CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}"/>
                                        </ImageBrush.ImageSource>
                                    </ImageBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{ThemeResource DsTextPrimaryBrush}" />

                                <!--
                                    The engine list rides on the status line rather than in a fixed
                                    130px column of its own. It used to be a column, which had to be
                                    kept in step with the card's copy of the same three fields by
                                    hand, and was not.
                                -->
                                <usercontrols:GameStatusView
                                    Variant="Row"
                                    Status="{x:Bind RowStatus, Mode=OneWay}" />
                            </StackPanel>

                            <usercontrols:GameActionButton
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Variant="Row"
                                Status="{x:Bind RowStatus, Mode=OneWay}"
                                Game="{x:Bind}"
                                Command="{Binding ElementName=RootGameGridPage, Path=ViewModel.RowActionCommand}" />
                        </Grid>

                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </DataTemplate>

        <DataTemplate x:Key="GridVeiwTemplate" x:DataType="pages:GameGridPageModel">

            <GridView PointerWheelChanged="MainGridView_PointerWheelChanged" ManipulationMode="None" x:Name="MainGridView" ItemsSource="{x:Bind CurrentCollectionView, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GridAndListView_ItemClick" Padding="20"  >

                <GridView.GroupStyle>
                    <!--
                        The header decides for itself whether it is drawn, rather than HidesIfEmpty
                        deciding for it. A folded section is empty by that test too, and its header
                        is the only way to unfold it.
                    -->
                    <GroupStyle
                        HidesIfEmpty="False"
                        HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                        HeaderContainerStyle="{StaticResource GridGroupHeaderContainerStyle}" />
                </GridView.GroupStyle>

                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="8"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <!--
                            Matched to the card's radius. The container paints its own rest and
                            hover background with square corners, which showed at each corner of the
                            rounded card and read as a shadow that did not fit the shape.
                        -->
                        <Setter Property="CornerRadius" Value="{StaticResource DsCornerRadiusLarge}"/>
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="data:Game">
                        <!--
                            Fixed height, and fixed rows inside it. A GridView takes the cell size
                            for the whole grid from the first item it measures, so a caption sized
                            by its own text would size every other card from whichever game
                            happened to come first.
                        -->
                        <Grid
                            Width="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewItemWidth, Mode=OneWay}"
                            Height="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewCardHeight, Mode=OneWay}"
                            CornerRadius="{StaticResource DsCornerRadiusLarge}"
                            Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
                            BorderThickness="1"
                            Margin="0,0,12,12"
                            Background="{ThemeResource DsSurfBrush}"
                            BorderBrush="{ThemeResource DsLine2Brush}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="76" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" CornerRadius="{StaticResource DsCornerRadiusLargeTop}">
                                <Grid>
                                    <!-- What is behind a cover that never arrived. The token existed and nothing used it. -->
                                    <Border Background="{ThemeResource DsCoverPlaceholderBrush}" />

                                    <!-- Weird, but allows image to strecth centered rather than left align -->
                                    <Border BorderThickness="0" FlowDirection="LeftToRight">
                                        <Border.RenderTransform>
                                            <CompositeTransform ScaleX="1" />
                                        </Border.RenderTransform>
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <!--
                                                        Decoded at the drawn size, not the stored
                                                        size - the same reasoning the list row
                                                        records, applied to the heaviest surface.
                                                        The width comes bucketed from the view
                                                        model so zoom ticks inside a bucket do not
                                                        re-decode every visible cover; see
                                                        GridViewCoverDecodeWidth for the numbers.
                                                    -->
                                                    <BitmapImage DecodePixelType="Logical" DecodePixelWidth="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewCoverDecodeWidth, Mode=OneWay}" UriSource="{x:Bind CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}"/>
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Border.Background>
                                    </Border>

                                    <!--
                                        Bottom right rather than top right: it acts on what the
                                        caption directly below it says, and poster art carries its
                                        own title across the top. Still on the art, so it still
                                        builds its own scrim.
                                    -->
                                    <usercontrols:GameActionButton
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right"
                                        Margin="8"
                                        Variant="Card"
                                        Status="{x:Bind RowStatus, Mode=OneWay}"
                                        Game="{x:Bind}"
                                        Command="{Binding ElementName=RootGameGridPage, Path=ViewModel.RowActionCommand}" />
                                </Grid>
                            </Border>

                            <!--
                                The caption, below the art rather than in a gradient over it.
                                Nothing here is painted white any more, so the theme's own text
                                tokens carry it and the contrast measured for a list row holds here
                                too — it used to depend on whatever the publisher shipped as art.
                            -->
                            <Grid Grid.Row="1" CornerRadius="{StaticResource DsCornerRadiusLargeBottom}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    Spec 2.6's rule. Always drawn, never only when a game is
                                    behind: a mark that comes and goes is a colour carrying a
                                    state, and the sentence beside it already says what is true.
                                -->
                                <Border Grid.Column="0" Background="{ThemeResource DsAccentBrush}" />

                                <StackPanel Grid.Column="1" Margin="10,8,10,10" Spacing="4">
                                    <!--
                                        The card has never shown a title while its cover loaded,
                                        only when one failed to. It is also the first thing that
                                        gives the card an automation name worth reading.
                                    -->
                                    <TextBlock
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource DsTextPrimaryBrush}" />

                                    <!--
                                        The same status the list rows carry, from the same control,
                                        rather than a hardcoded "DLSS" label, a version number and
                                        vendor coloured badges. The card had been claiming every
                                        game was about DLSS regardless of what it actually ships.
                                    -->
                                    <usercontrols:GameStatusView
                                        Variant="Card"
                                        Status="{x:Bind RowStatus, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>

                </GridView.ItemTemplate>
            </GridView>

        </DataTemplate>

        <usercontrols:ListGridViewTemplateSelector x:Key="TemplateSelector"
                                  ListViewTemplate="{StaticResource ListViewTemplate}"
                                  GridVeiwTemplate="{StaticResource GridVeiwTemplate}"/>
        
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,0,16,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.TranslationProperties.PageTitle, Mode=OneWay}" Margin="16,0,0,0" TextWrapping="NoWrap" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <muxc:ProgressRing IsActive="True" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"  />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Grid Width="300" Margin="10,0,0,0">
                    <!-- 32 like every other control; it was a 20px box beside 32px buttons. -->
                    <TextBox x:Name="SearchBox"
                        Height="32"
                        Padding="8,6,32,0"
                        AcceptsReturn="True"
                        IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.TranslationProperties.SearchText, Mode=OneWay}"
                        TextChanged="{x:Bind ViewModel.SearchForGameEvent}" />

                    <Button x:Name="ClearButton"
                            AutomationProperties.Name="{x:Bind ViewModel.TranslationProperties.ClearSearchText, Mode=OneWay}"
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,4,0"
                            Padding="4"
                            Visibility="{x:Bind SearchBox.Text, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                            Click="ClearSearchBox_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <ToolTipService.ToolTip>
                            <TextBlock Text="{x:Bind ViewModel.TranslationProperties.ClearSearchText, Mode=OneWay}" />
                        </ToolTipService.ToolTip>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.NewDllsText, Mode=OneWay}" Command="{x:Bind ViewModel.UnknownAssetsFoundButtonCommand}" Visibility="{x:Bind data:GameManager.Instance.UnknownAssetsFound, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE946;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.AddGameText, Mode=OneWay}" Command="{x:Bind ViewModel.AddManualGameButtonCommand}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE710;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.FindCoversText, Mode=OneWay}" Command="{x:Bind ViewModel.FindCoversCommand}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xEB9F;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <!-- ED62 is the same restore shape the picker's per-dll restore button wears. -->
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.RestoreOriginalsText, Mode=OneWay}" Command="{x:Bind ViewModel.RestoreAllGamesCommand}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xED62;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.RefreshText, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshGamesButtonCommand}" IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <!--
                    Nothing in this toolbar decides which games are shown any more. There was a
                    "Filter" button holding two controls: one was a worse copy of the Hidden tab,
                    and the other was this — how the same games are arranged, which is a view
                    option and belongs here beside grid and list.
                -->
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.ViewTypeText, Mode=OneWay}" Content="{x:Bind ViewModel.GameGridViewIcon, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <!--
                            Constrained to the window, and placed below its button. A WinUI 3
                            desktop flyout is its own top level window and is free to leave the
                            app's bounds; this one opened upwards past the title bar and rendered on
                            the desktop above the app, where its items could be read but the app it
                            belonged to could not be seen. It is a property of the flyout rather
                            than of the presenter, so it cannot be set once in a Style.
                        -->
                        <MenuFlyout ShouldConstrainToRootBounds="True" Placement="Bottom">
                            <!--
                                Radio items rather than plain ones, so an open menu says which view
                                is current. It was readable only from the button's glyph, which
                                means knowing the glyphs already.
                            -->
                            <RadioMenuFlyoutItem
                                GroupName="GameView"
                                Text="{x:Bind ViewModel.TranslationProperties.GridViewText, Mode=OneWay}"
                                IsChecked="{x:Bind ViewModel.IsGridView, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ChangeGameGridViewCommand}"
                                CommandParameter="{x:Bind pages:GameGridViewType.GridView}" />
                            <RadioMenuFlyoutItem
                                GroupName="GameView"
                                Text="{x:Bind ViewModel.TranslationProperties.ListViewText, Mode=OneWay}"
                                IsChecked="{x:Bind ViewModel.IsListView, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ChangeGameGridViewCommand}"
                                CommandParameter="{x:Bind pages:GameGridViewType.ListView}" />

                            <MenuFlyoutSeparator />

                            <!--
                                Checked rather than two items, so the menu states the setting rather
                                than only offering to change it. Applies on click; behind the old
                                dialog it needed an Apply.
                            -->
                            <ToggleMenuFlyoutItem
                                Text="{x:Bind ViewModel.TranslationProperties.GroupByLibraryText, Mode=OneWay}"
                                IsChecked="{x:Bind ViewModel.IsGroupedByLibrary, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleGroupByLibraryCommand}" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <InfoBar x:Name="AdminInfoBar"
                     IsOpen="True"
                     Severity="Warning"
                     IsClosable="False"
                     Title="{x:Bind ViewModel.TranslationProperties.WarningTitleText, Mode=OneWay}"
                     Message="{x:Bind ViewModel.TranslationProperties.ApplicationRunsInAdministrativeModeInfo, Mode=OneWay}"
                     Visibility="{x:Bind system:Environment.IsPrivilegedProcess, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--
                    Swaps a game update quietly overwrote. The scan has always recorded these and
                    deleted the stranded backup; the record's only home was the history dialog
                    nobody opens unprompted. Closing the bar acknowledges exactly what it showed -
                    a swap undone later brings it back.
                -->
                <InfoBar x:Name="UndoneSwapsInfoBar"
                     Severity="Warning"
                     IsOpen="{x:Bind ViewModel.UndoneSwapsIsOpen, Mode=OneWay}"
                     Title="{x:Bind ViewModel.UndoneSwapsTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.UndoneSwapsMessage, Mode=OneWay}"
                     CloseButtonClick="UndoneSwapsInfoBar_CloseButtonClick" />

                <!--
                    A swap the previous session did not finish - the app closed or was killed between
                    renaming two copies of a dll - was put back as this session started. Said once,
                    here, because the games it names look untouched now and nothing else would say so.
                -->
                <InfoBar x:Name="InterruptedSwapsInfoBar"
                     Severity="Warning"
                     IsOpen="{x:Bind ViewModel.InterruptedSwapsIsOpen, Mode=OneWay}"
                     Title="{x:Bind ViewModel.InterruptedSwapsTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.InterruptedSwapsMessage, Mode=OneWay}"
                     CloseButtonClick="InterruptedSwapsInfoBar_CloseButtonClick" />
            </StackPanel>

            <!--
                Filter tabs. Each carries the count of what it would show, from the same rule that
                decides what it shows, so the number cannot disagree with the list. A tab with
                nothing in it shows no number rather than a zero, which reads as an error.
            -->
            <Grid Grid.Row="2" Height="38" Margin="16,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Stretch">

                <ItemsControl ItemsSource="{x:Bind ViewModel.FilterTabs, Mode=OneWay}" VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="data:GameFilterTab">
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="0"
                                VerticalAlignment="Stretch"
                                Command="{Binding ElementName=RootGameGridPage, Path=ViewModel.SelectFilterCommand}"
                                CommandParameter="{x:Bind}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="2" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Opacity="{x:Bind LabelOpacity}">
                                        <TextBlock Text="{x:Bind Label}" FontSize="13" Foreground="{ThemeResource DsTextPrimaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind CountText}"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind CountVisibility}"
                                            Foreground="{ThemeResource DsTextSecondaryBrush}" />
                                    </StackPanel>

                                    <Border
                                        Grid.Row="1"
                                        Background="{ThemeResource DsTextPrimaryBrush}"
                                        Visibility="{x:Bind UnderlineVisibility}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Says what the page is narrowed to and offers to stop, and appears only while it
                    is. Arriving here from the upscalers page otherwise means a library of twenty
                    three games quietly showing three, with nothing on screen saying why, which is
                    indistinguishable from a broken library. The words carry it; the dismiss is a
                    labelled button rather than a bare glyph.
                -->
                <Border
                    VerticalAlignment="Center"
                    Padding="10,0,4,0"
                    CornerRadius="{StaticResource DsCornerRadius}"
                    Background="{ThemeResource DsSurf2Brush}"
                    Visibility="{x:Bind ViewModel.DllFilterVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            Text="{x:Bind ViewModel.DllFilterLabel, Mode=OneWay}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            TextWrapping="NoWrap"
                            Foreground="{ThemeResource DsTextSecondaryBrush}" />
                        <Button
                            Width="24"
                            Height="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="{StaticResource DsCornerRadius}"
                            Command="{x:Bind ViewModel.ClearDllFilterCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TranslationProperties.ClearDllFilterText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.TranslationProperties.ClearDllFilterText, Mode=OneWay}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource DsTextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                </StackPanel>

                <Button
                    Grid.Column="1"
                    Height="32"
                    Padding="16,0"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource DsCornerRadius}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Content="{x:Bind ViewModel.ReviewUpdatesText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ReviewUpdatesVisibility, Mode=OneWay}"
                    Command="{x:Bind ViewModel.UpdateAllGamesButtonCommand}" />
            </Grid>
        </Grid>

        <!--
            The bottom margin is the batch strip's height, applied only while the strip is there.
            The strip is docked over the content rather than beside it, so without this the last row
            sits behind it and looks like the end of the list.
        -->
        <!--
            AccessibilityView follows whether a sheet is up. A scrim only stops the pointer, so
            without this a screen reader walks out of the sheet onto the game cards behind it and
            invokes them without ever needing focus - which the pointer scrim and the focus trap
            both fail to prevent, because neither is what the control view is built from.
        -->
        <ContentControl x:Name="MainContentControl" Grid.Row="1" AutomationProperties.AccessibilityView="{x:Bind ViewModel.BehindSheetAccessibilityView, Mode=OneWay}" Margin="{x:Bind ViewModel.ContentBottomMargin, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" Content="{x:Bind ViewModel, Mode=OneWay}" ContentTemplateSelector="{StaticResource TemplateSelector}" />

        <!--
            What the content area says when there is nothing in it. Flush left rather than centred
            text, because it is a paragraph to read and a decision to make, not a placard.
        -->
        <Grid Grid.Row="1" Padding="60,0" Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}" Background="{ThemeResource DsBgBrush}">
            <StackPanel MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="14">
                <TextBlock
                    Text="{x:Bind ViewModel.EmptyState.Title, Mode=OneWay}"
                    FontSize="30"
                    LineHeight="38"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource DsTextPrimaryBrush}" />

                <TextBlock
                    Text="{x:Bind ViewModel.EmptyState.Body, Mode=OneWay}"
                    FontSize="14"
                    LineHeight="22"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.EmptyState.Body, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                    Foreground="{ThemeResource DsTextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button
                        Height="36"
                        Padding="20,0"
                        CornerRadius="{StaticResource DsCornerRadius}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Content="{x:Bind ViewModel.EmptyState.PrimaryLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.EmptyState.PrimaryLabel, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                        Command="{x:Bind ViewModel.EmptyStatePrimaryCommand}" />

                    <Button
                        Height="36"
                        Padding="20,0"
                        CornerRadius="{StaticResource DsCornerRadius}"
                        Content="{x:Bind ViewModel.EmptyState.SecondaryLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.EmptyState.SecondaryLabel, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                        Command="{x:Bind ViewModel.EmptyStateSecondaryCommand}" />
                </StackPanel>

                <TextBlock
                    Text="{x:Bind ViewModel.EmptyState.Hint, Mode=OneWay}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Margin="0,4,0,0"
                    Visibility="{x:Bind ViewModel.EmptyState.Hint, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                    Foreground="{ThemeResource DsTextTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!--
            The batch strip: what a run is doing, then what it did. Docked to the bottom of the
            content rather than shown as a dialog, so the library stays visible and scrollable while
            the app writes to it.
        -->
        <Border
            Grid.Row="1"
            VerticalAlignment="Bottom"
            Height="52"
            Padding="26,0"
            Background="{ThemeResource DsSurfBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DsLine2Brush}"
            Visibility="{x:Bind ViewModel.UpdateBatchVisibility, Mode=OneWay}">

            <Grid>
                <!-- Running -->
                <Grid ColumnSpacing="14" Visibility="{x:Bind ViewModel.UpdateBatch.RunningVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar
                        Grid.Column="0"
                        Width="130"
                        Height="2"
                        VerticalAlignment="Center"
                        Value="{x:Bind ViewModel.UpdateBatch.ProgressValue, Mode=OneWay}" />

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.UpdateBatch.ProgressText, Mode=OneWay}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        TextWrapping="NoWrap"
                        Foreground="{ThemeResource DsTextPrimaryBrush}" />

                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.UpdateBatch.CurrentItemText, Mode=OneWay}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource DsTextSecondaryBrush}" />

                    <Button
                        Grid.Column="3"
                        Height="32"
                        Padding="16,0"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource DsCornerRadius}"
                        Content="{x:Bind ViewModel.UpdateBatch.StopLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.UpdateBatch.CanStop, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StopUpdateBatchCommand}" />
                </Grid>

                <!-- Done -->
                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.UpdateBatch.DoneVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Glyph="{x:Bind ViewModel.UpdateBatch.DoneGlyph, Mode=OneWay}"
                        Foreground="{ThemeResource DsTextPrimaryBrush}" />

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.UpdateBatch.DoneText, Mode=OneWay}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        TextWrapping="NoWrap"
                        Foreground="{ThemeResource DsTextPrimaryBrush}" />

                    <!--
                        The reassurance sits next to the outcome rather than in a dialog that has to
                        be dismissed, because it is the answer to "what did I just do to my games".
                    -->
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.UpdateBatch.DoneDetailText, Mode=OneWay}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource DsTextSecondaryBrush}" />

                    <!--
                        Both live in this column, and the model keeps them apart: a partial batch is
                        both, and failures win, because what did not work has to be read before what
                        did.
                    -->
                    <Button
                        Grid.Column="3"
                        Height="32"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource DsCornerRadius}"
                        Visibility="{x:Bind ViewModel.UpdateBatch.FailuresVisibility, Mode=OneWay}"
                        Content="{x:Bind ViewModel.UpdateBatch.SeeWhatFailedLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ShowBatchFailuresCommand}" />

                    <Button
                        Grid.Column="3"
                        Height="32"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource DsCornerRadius}"
                        Visibility="{x:Bind ViewModel.UpdateBatch.ChangesVisibility, Mode=OneWay}"
                        Content="{x:Bind ViewModel.UpdateBatch.SeeWhatChangedLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ShowBatchChangesCommand}" />

                    <Button
                        Grid.Column="4"
                        Height="32"
                        Padding="16,0"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource DsCornerRadius}"
                        Visibility="{x:Bind ViewModel.UpdateBatch.UndoVisibility, Mode=OneWay}"
                        Content="{x:Bind ViewModel.UpdateBatch.UndoLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.UndoUpdateBatchCommand}" />

                    <!--
                        Labelled, like every other button in this strip. It was a bare cross with no
                        label, no tooltip and no automation name, so the only way to clear the strip
                        was to find a 12px glyph nothing named - and it got reported as the strip
                        never going away.
                    -->
                    <Button
                        Grid.Column="5"
                        Height="32"
                        Padding="16,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource DsCornerRadius}"
                        Content="{x:Bind ViewModel.UpdateBatch.DismissLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.DismissUpdateBatchCommand}" />
                </Grid>
            </Grid>
        </Border>

        <!--
            The preview sheet, over the whole page including the command bar.
            It used to sit in the content row only, so the bar it was opened from stayed visible -
            which also left it live. Refresh and the filter tabs still acted on the list behind it,
            and with a game open you could press "Review N updates" and render the confirm step for
            writing dlls into game folders underneath the other sheet's scrim: dimmed, unclickable,
            and unreachable by keyboard because the focus trap dragged focus back out of it.
            Covering the header is what makes a modal modal.
        -->
        <!--
            TabFocusNavigation Cycle as well as the GettingFocus handler in the code behind, which is
            what a ContentDialog does - see BackgroundElement in Themes/FakeContentDialogStyle.xaml.
            The handler is hooked on the page, so it only sees focus moving to somewhere inside the
            page; the shell sidebar lives outside it, in the window. Tabbing off the end was not
            observed to reach the sidebar on this build - it was checked at 10, 14 and 23 presses and
            stayed in the sheet every time - but that is the page's tab order happening to wrap, not
            anything this sheet arranged. Cycle makes it the sheet's own rule.
        -->
        <Grid
            x:Name="UpdatePreviewSheet"
            Grid.Row="0"
            Grid.RowSpan="2"
            TabFocusNavigation="Cycle"
            AutomationProperties.IsDialog="True"
            AutomationProperties.Name="{x:Bind ViewModel.UpdatePreview.Title, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.UpdatePreviewVisibility, Mode=OneWay}">
            <!-- Clicking away is a cancel, same as Esc and the Cancel button. -->
            <Border Background="{ThemeResource DsScrimBrush}" Tapped="UpdatePreviewBackdrop_Tapped" />

            <Border
                Width="640"
                MaxHeight="560"
                Margin="0,16,0,16"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Background="{ThemeResource DsBgBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource DsLine2Brush}"
                CornerRadius="{StaticResource DsCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Padding="22,20,22,14"
                        Spacing="6"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource DsLineBrush}">
                        <TextBlock
                            Text="{x:Bind ViewModel.UpdatePreview.Title, Mode=OneWay}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource DsTextPrimaryBrush}" />
                        <!--
                            The reassurance is the point of the sheet, not decoration: it is the only
                            place the app says a copy of the original is kept before it writes.
                        -->
                        <TextBlock
                            Text="{x:Bind ViewModel.UpdatePreview.Body, Mode=OneWay}"
                            FontSize="12"
                            LineHeight="19"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource DsTextSecondaryBrush}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.UpdatePreview.Updates, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="data:PendingDllUpdate">
                                    <Grid
                                        Height="40"
                                        Padding="22,0"
                                        ColumnSpacing="12"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource DsLineBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            Named with the whole row. These sit in an ItemsControl,
                                            so there is no ListViewItem gathering the four columns
                                            into one announcement - without this a screen reader met
                                            a column of "checkbox, checked" with no game named,
                                            immediately above a button that writes into game folders.
                                        -->
                                        <CheckBox
                                            Grid.Column="0"
                                            MinWidth="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind AccessibleDescription}"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind GameTitle}"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{ThemeResource DsTextPrimaryBrush}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind EngineName}"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{ThemeResource DsTextSecondaryBrush}" />

                                        <!--
                                            Both versions, which the rows themselves deliberately
                                            never show. On a row a version delta means nothing
                                            without knowing which way is newer; here the whole
                                            question is what changes, so it is the substance.
                                        -->
                                        <!--
                                            How much is known about this version in this game, as a
                                            shape and a word, with the sentence behind it in the
                                            tooltip and in the row's accessible name. Never colour
                                            alone: the four glyphs are four different shapes.
                                        -->
                                        <StackPanel
                                            Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind Confidence.Reason}">
                                            <FontIcon
                                                Glyph="{x:Bind Confidence.Glyph}"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource DsTextSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind Confidence.Label}"
                                                FontSize="12"
                                                MinWidth="96"
                                                VerticalAlignment="Center"
                                                TextWrapping="NoWrap"
                                                Foreground="{ThemeResource DsTextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind FromVersion}"
                                                FontSize="12"
                                                FontFamily="Consolas"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource DsTextTertiaryBrush}" />
                                            <FontIcon
                                                Glyph="&#xE72A;"
                                                FontSize="10"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource DsTextTertiaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ToVersion}"
                                                FontSize="12"
                                                FontFamily="Consolas"
                                                MinWidth="74"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource DsAccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid
                        Grid.Row="2"
                        Padding="22,14"
                        ColumnSpacing="12"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource DsLineBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind ViewModel.UpdatePreview.CloseGamesFirst, Mode=OneWay}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource DsTextTertiaryBrush}" />

                        <Button
                            Grid.Column="1"
                            Height="32"
                            Padding="16,0"
                            CornerRadius="{StaticResource DsCornerRadius}"
                            Content="{x:Bind ViewModel.UpdatePreview.CancelLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CancelUpdatePreviewCommand}" />

                        <Button
                            Grid.Column="2"
                            Height="32"
                            Padding="16,0"
                            CornerRadius="{StaticResource DsCornerRadius}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Content="{x:Bind ViewModel.UpdatePreview.ConfirmLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.UpdatePreview.CanConfirm, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ConfirmUpdatePreviewCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--
            One game's details, over the list rather than instead of it. The list keeps its scroll
            position, its search and its tab, because nothing navigated - so opening a game, changing
            a dll and coming back is one motion.

            Deliberately the same shape as the update preview above: same scrim, same Escape, same
            click-away, same TabFocusNavigation. The page inside is the same GameDetailPage that used
            to fill the frame, hosted rather than rewritten, so there is one description of a game
            and not two to keep in step.
        -->
        <Grid
            x:Name="GameDetailSheet"
            Grid.Row="0"
            Grid.RowSpan="2"
            TabFocusNavigation="Cycle"
            AutomationProperties.IsDialog="True"
            AutomationProperties.Name="{x:Bind ViewModel.GameDetailAccessibleName, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.GameDetailVisibility, Mode=OneWay}">

            <!-- Clicking away closes it, the same as Escape and the header's back button. -->
            <Border
                Background="{ThemeResource DsScrimBrush}"
                Tapped="GameDetailBackdrop_Tapped"
                AutomationProperties.AccessibilityView="Raw" />

            <!--
                Sized to what the game actually has, not to the window. Stretched, it left a field of
                empty sheet under a game with two dlls; centred, it grows with the content and the
                page's own scroll viewer takes over once it reaches the cap.
            -->
            <Border
                MaxWidth="1100"
                MaxHeight="900"
                VerticalAlignment="Center"
                Margin="16"
                Background="{ThemeResource DsBgBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource DsLine2Brush}"
                CornerRadius="{StaticResource DsCornerRadius}">

                <!--
                    The page brings its own header, scrolling middle and action row, so it needs
                    nothing but somewhere to sit.
                -->
                <ContentControl
                    x:Name="GameDetailHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False" />
            </Border>
        </Grid>

    </Grid>
</Page>

